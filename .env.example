# --- Basic ---
PORT="3000"
# HOST="127.0.0.1"

# --- Access control ---
# Optional. When set, the model relay (/api/models, /api/chat/completions) requires
# visitors to enter this code once; they then get a signed HttpOnly session cookie.
# Strongly recommended for a public server.
# ACCESS_CODE=""
# Keeps sessions valid across restarts (random per process when unset).
# SESSION_SECRET=""
# SESSION_TTL_HOURS="168"

# --- Reverse proxy ---
# Set to the number of proxies in front of the app (e.g. 1 for Nginx/Caddy/a cloud LB)
# so rate limits see the real client IP and the session cookie gets the Secure flag.
# TRUST_PROXY="1"

# --- Upstream (model provider) safety ---
# By default the relay refuses private/loopback/link-local/reserved addresses.
# Enable ONLY for local testing, e.g. a model server on localhost, or a dev machine
# behind a fake-IP proxy/VPN (Clash/Surge TUN resolve public hosts to 198.18.0.0/15).
# Pair it with HOST=127.0.0.1 so the dev server is not exposed to your LAN.
# ALLOW_PRIVATE_UPSTREAM="false"
# Restrict the relay to specific provider hosts (subdomains match too).
# UPSTREAM_ALLOWED_HOSTS="api.openai.com,dashscope.aliyuncs.com"

# --- Limits (defaults shown) ---
# CHAT_RATE_LIMIT="20"            # AI analyses per client IP per window
# CHAT_RATE_WINDOW_MS="600000"
# MODELS_RATE_LIMIT="30"
# MODELS_RATE_WINDOW_MS="600000"
# RELAY_MAX_CONCURRENT="8"        # in-flight relays, whole server
# RELAY_MAX_CONCURRENT_PER_IP="2"
# MAX_BODY_MB="50"                # max request body for AI analysis
# UPSTREAM_TIMEOUT_MS="300000"    # whole AI analysis
# UPSTREAM_IDLE_TIMEOUT_MS="120000"  # no data from the provider
# HEARTBEAT_INTERVAL_MS="10000"   # keep-alive bytes while waiting for the model
